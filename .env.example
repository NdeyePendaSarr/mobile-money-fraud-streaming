# Copier en .env (jamais versionné) puis choisir un mot de passe.
# Aucune valeur de ce fichier n'est un secret réel.
# Variables préfixées SENPAY_ : une variable exportée dans le shell l'emporte sur
# ce fichier (Docker Compose et uv) ; le préfixe évite les collisions avec le
# projet 1 (POSTGRES_*), et `make up` refuse un SENPAY_* ou POSTGRES_* exporté.

# PostgreSQL du projet. Port hôte 5434 : 5432 = PostgreSQL local de Windows,
# 5433 = projet 1 (les deux projets peuvent tourner en même temps).
SENPAY_PG_USER=senpay
SENPAY_PG_PASSWORD=a_changer
SENPAY_PG_DB=senpay
SENPAY_PG_HOST=127.0.0.1
SENPAY_PG_PORT=5434

# Kafka : listener HOST, publié sur 127.0.0.1 (les conteneurs utilisent kafka:29092)
SENPAY_KAFKA_HOST_PORT=9092
SENPAY_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
